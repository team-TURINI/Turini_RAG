# 필수 — 임베딩 + 생성 LLM
OPENAI_API_KEY=sk-...

# Multi-turn Query Understanding / Conversation Summary
QUERY_REWRITE_MODEL=gpt-4.1-mini
# 선택값. 사용하는 모델이 지원하는 경우에만 설정
QUERY_REWRITE_REASONING_EFFORT=
QUERY_SUMMARY_MODEL=gpt-4.1-mini

# 선택 — LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=turini-query-rewriter
# 기본 LangSmith SaaS endpoint를 사용할 때는 비워 둔다.
LANGSMITH_ENDPOINT=

# 필수 (최종 파이프라인) — Cohere 리랭커
#   Trial 키는 분당 10회 제한 → 157문항 약 17분. 반복 실행하려면 Production 키 권장
COHERE_API_KEY=...

# 선택 — 인덱스 디렉토리 (기본: ./vectorstores)
# INDEX_DIR=/var/lib/rag/vectorstores
